<!-- Compiles with the .NET 8 SDK; not yet run on a Mac. Bindings are plain {Binding} (no x:DataType); names must match MainViewModel. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:CookieJar.Core;assembly=CookieJar.Core"
        x:Class="CookieJar.App.MainWindow"
        Title="Cookie Jar"
        Width="1000" Height="920" MinWidth="800" MinHeight="700"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}">
  <ScrollViewer Padding="24">
    <StackPanel Spacing="12">

      <!-- Header -->
      <StackPanel>
        <TextBlock Text="Cookie Jar" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text}" />
        <TextBlock Text="Run several Roblox clients side by side. Launch a whole profile of accounts with one click, or start one from the website."
                   FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" />
      </StackPanel>

      <!-- Stat strip -->
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="14" Padding="18,14">
        <StackPanel Orientation="Horizontal" Spacing="24">
          <StackPanel>
            <TextBlock Text="ACTIVE" FontSize="11" Foreground="{DynamicResource TextMuted}" />
            <TextBlock Text="{Binding ActiveCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Text}" />
          </StackPanel>
          <TextBlock Text="{Binding StatusLine}" FontSize="12" Foreground="{DynamicResource TextMuted}"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Profiles card -->
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="14" Padding="18,14">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <!-- Profiles and LaunchProfileCommand are not on MainViewModel yet (see report). -->
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                    MinWidth="260" />
          <Button Content="Launch profile" Command="{Binding LaunchProfileCommand}"
                  Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" />
        </StackPanel>
      </Border>

      <!-- Instance cards -->
      <ItemsControl ItemsSource="{Binding Instances}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <StackPanel Grid.Column="0">
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text}" />
                  <TextBlock Text="{Binding AccountName}" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="13" Foreground="{DynamicResource Text}"
                           VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="2" Text="{Binding MemoryText}" FontSize="13" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="3" Text="{Binding Uptime}" FontSize="13" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="12,0" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                  <!-- Tooltip sits on the wrapper: disabled controls may not receive hover in Avalonia. -->
                  <!-- Focus: this client fullscreen, the others at background priority. MAC-UNVERIFIED: not run on a Mac;
                       macOS cannot raise priority again without root, so Unfocus may leave the others slowed. -->
                  <Border ToolTip.Tip="{Binding FocusFeature.Reason}">
                    <Button Content="{Binding FocusLabel}" Command="{Binding FocusCommand}" IsEnabled="{Binding FocusFeature.Enabled}" />
                  </Border>
                  <Border ToolTip.Tip="{Binding KillFeature.Reason}">
                    <Button Content="Kill" Command="{Binding KillCommand}" IsEnabled="{Binding KillFeature.Enabled}" />
                  </Border>
                  <Border ToolTip.Tip="{Binding RelaunchFeature.Reason}">
                    <Button Content="Relaunch" Command="{Binding RelaunchCommand}" IsEnabled="{Binding RelaunchFeature.Enabled}" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- RAM slider -->
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
              BorderThickness="1" CornerRadius="14" Padding="18,14">
        <StackPanel Spacing="6">
          <TextBlock Text="Memory cap per instance" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Text}" />
          <Grid ColumnDefinitions="*,Auto">
            <!-- Position 0 is Auto (no cap); Steps is the highest capped position. -->
            <Slider x:Name="RamSlider" Grid.Column="0" Minimum="0"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding RamIndex, Mode=TwoWay}" />
            <TextBlock Grid.Column="1" Text="{Binding RamLabel}" FontSize="13" Foreground="{DynamicResource Text}"
                       VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="72" />
          </Grid>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</Window>
