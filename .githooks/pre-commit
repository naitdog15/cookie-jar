#!/bin/sh
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File scripts/validate-release.ps1 -Staged
elif command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/validate-release.ps1 -Staged
else
    echo "Release check requires PowerShell (pwsh, or powershell.exe on Windows)." >&2
    exit 1
fi
